# Operator-side template. #128 owns publication; do not install in the client repo.
service: yolo-__APP_SLUG__
image: yolo-__APP_SLUG__
minimum_version: 2.12.0
servers:
  web:
    hosts:
      - <%= ENV.fetch("YOLO_HOST_IP") %>
    options:
      user: "10001:10001"
      memory: 3g
      memory-swap: 3g
      cpus: "0.75"
      pids-limit: "256"
      cap-drop: ALL
      security-opt: no-new-privileges:true
      read-only: true
      tmpfs: /tmp:rw,noexec,nosuid,size=64m
registry:
  server: localhost:5555
proxy:
  ssl: false
  host: api-origin-__APP_SLUG__.yolo-dev.ai
  app_port: 3000
  healthcheck:
    path: /ready
    interval: 2
    timeout: 5
  run:
    version: v0.9.2
    bind_ips:
      - 127.0.0.1
    options:
      memory: 256m
      cpus: "0.25"
ssh:
  user: ubuntu
  keys:
    - <%= ENV.fetch("YOLO_SSH_KEY") %>
builder:
  arch: arm64
  context: .
volumes:
  - /srv/yolo/__APP_SLUG__:/data
logging:
  driver: local
  options:
    max-size: 10m
    max-file: "3"
env:
  clear:
    PORT: "3000"
    DATA_DIRECTORY: /data
