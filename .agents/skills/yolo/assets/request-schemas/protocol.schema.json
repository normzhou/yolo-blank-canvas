{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request resolution protocol v1",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "required": [
          "id",
          "title",
          "requirements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "id",
    "version",
    "title",
    "stages"
  ],
  "additionalProperties": false
}
