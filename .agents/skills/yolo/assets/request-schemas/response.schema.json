{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator request response v1",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "request": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "repository",
            "number",
            "node_id"
          ],
          "additionalProperties": false
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "issue",
        "input_sha256",
        "source_sha256",
        "source_updated_at"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "disposition": {
      "enum": [
        "unreviewed",
        "clarifying",
        "tracked",
        "accepted",
        "declined",
        "duplicate",
        "withdrawn",
        "partial",
        "fulfilled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "relation": {
            "enum": [
              "required",
              "related"
            ]
          }
        },
        "required": [
          "url",
          "relation"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "fulfillment": {
      "type": "object",
      "properties": {
        "process": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
              "maxLength": 160
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        }
      },
      "required": [
        "process",
        "state"
      ],
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
            "maxLength": 160
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "actor"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "url",
          "claim",
          "observed_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "result": {
      "type": "object"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "evaluated_replies": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "comment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "body_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "in_reply_to_revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "comment_id",
              "updated_at",
              "body_sha256",
              "in_reply_to_revision"
            ],
            "additionalProperties": false
          }
        },
        "accepted_items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "pending_items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "actor": {
                "enum": [
                  "requester",
                  "receiver",
                  "manual_owner"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "actor",
              "action"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "evaluated_replies",
        "accepted_items",
        "pending_items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format_version",
    "request",
    "template",
    "revision",
    "updated_at",
    "disposition",
    "summary",
    "outcomes",
    "next_actions",
    "evidence",
    "result",
    "protocol",
    "conversation"
  ],
  "additionalProperties": false
}
