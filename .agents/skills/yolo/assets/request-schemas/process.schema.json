{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request fulfillment process definition v1",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "initial": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 80
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 80
      },
      "maxItems": 100,
      "minItems": 1,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
        "maxLength": 160
      },
      "maxItems": 100,
      "minItems": 1,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
            "maxLength": 160
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "actor",
          "title",
          "instructions"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 30,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 80
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "terminal": {
            "type": "boolean"
          },
          "next_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
              "maxLength": 160
            },
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "title",
          "terminal",
          "next_actions"
        ],
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80
            },
            "maxItems": 100,
            "minItems": 1,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
              "maxLength": 160
            },
            "maxItems": 100,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "from",
          "to",
          "by",
          "checks"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "format_version",
    "id",
    "version",
    "title",
    "initial",
    "roles",
    "checks",
    "actions",
    "states",
    "transitions"
  ],
  "additionalProperties": false
}
