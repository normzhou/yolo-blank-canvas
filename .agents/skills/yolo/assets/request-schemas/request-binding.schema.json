{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "issue": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "url",
        "node_id"
      ],
      "additionalProperties": false
    },
    "requester_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "format": {
      "enum": [
        "json",
        "github",
        "plain"
      ]
    },
    "canonical_comment": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "id",
            "node_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "observed": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "comment_id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "comment_node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "body_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "record_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{32}$"
            },
            "receipt_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "receipt_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "comment_id",
            "comment_node_id",
            "revision",
            "body_sha256",
            "record_sha256",
            "operation_id",
            "receipt_id",
            "receipt_sha256"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "format_version",
    "issue",
    "requester_id",
    "template",
    "format",
    "canonical_comment",
    "observed"
  ],
  "additionalProperties": false
}
