{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yolo-arcade",
  "version": "0.38.0",
  "identifier": "ai.yolodev.arcade",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YOLO Arcade",
        "url": "https://demo.yolo-dev.ai/?shell=tauri",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 145
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 145
        }
      }
    }
  }
}
