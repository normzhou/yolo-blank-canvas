{
  "name": "yolo-blank-canvas",
  "version": "0.3.1",
  "private": false,
  "description": "Blank canvas with a Requests overlay over one GitHub repository",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "yolo-blank-canvas": "./server/cli.js"
  },
  "files": [
    "server",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:client",
    "build:client": "vite build",
    "dev": "node server/cli.js --dev",
    "start": "node server/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "e2e:visual": "playwright test --config playwright.config.ts visual motion",
    "e2e:measure": "playwright test --config playwright.config.ts measure"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
